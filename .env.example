# Copy this file to .env and fill in your own values. Never commit real secrets.
SECRET_KEY=replace-with-a-long-random-secret
FLASK_ENV=development
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
DEFAULT_CITY=Nagpur
OPENWEATHER_API_KEY=
SOS_EMERGENCY_NUMBER=112
# Optional email notifications
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
